# =============================================================================
#  توقيع إصدار release — انسخ هذا الملف إلى  keystore.properties
#  (لا يُرفع إلى git إطلاقاً: هو في .gitignore)
#
#  إن لم يوجد الملف، يبني Gradle إصدار release غير موقَّع، وهذا مقبول
#  للتجربة. للتوزيع أنشئ مفتاحاً:
#
#    keytool -genkeypair -v -keystore sawti.jks -keyalg RSA -keysize 2048 \
#            -validity 10000 -alias sawti
#
# =============================================================================

storeFile=/absolute/path/to/sawti.jks
storePassword=CHANGE_ME
keyAlias=sawti
keyPassword=CHANGE_ME
