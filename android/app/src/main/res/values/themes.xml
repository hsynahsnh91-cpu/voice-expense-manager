<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- السمة الأساسية. التطبيق كله Jetpack Compose، فهذه السمة تضبط
         نافذة النظام (شريط الحالة، الخلفية قبل تحميل Compose) فقط. -->
    <style name="Theme.Sawti" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand_700</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="colorPrimary">@color/brand_600</item>
        <item name="colorAccent">@color/brand_500</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
